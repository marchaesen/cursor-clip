[Unit]
Description=Cursor Clip Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStartPre=/bin/sh -c 'while ! ls %t/wayland-[0-9] >/dev/null 2>&1; do sleep 1; done'
#ExecStart=/usr/local/bin/cursor-clip --daemon
ExecStart=/bin/sh -c 'WAYLAND_DISPLAY=$(basename $(ls %t/wayland-[0-9] | head -n 1)) exec cursor-clip --daemon'

Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target

